; Execution posture: native local strategy, trading ARMED (no AOS command channel).
; ---------------------------------------------------------------------------
; Execution posture (Pass-1 requirement)
InpAosCmdEnabled=false
InpEnableTrading=true
; Strategy forced to BREAKOUT (StrategyMode: 0=BREAKOUT, 1=MEANREVERT, 2=AUTO)
InpStrategyMode=0
; ---------------------------------------------------------------------------
; Session filter (preset: 07:00-20:00)
